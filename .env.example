PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/medtracker
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
HF_TOKEN=your_hugging_face_token
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-url.vercel.app

# RAG Service (FastAPI) — Evidence-grounded retrieval subsystem
# If RAG_SERVICE_URL is empty, RAG indexing/queries are skipped gracefully.
RAG_SERVICE_URL=http://localhost:8000
# Shared secret for service-to-service calls (FastAPI <-> Express).
# Generate a new secure secret for production.
RAG_SERVICE_SECRET=your_rag_service_secret

# RAG cache + index versioning (rag-service reads cache via REDIS_URL above).
# Bump INDEX_VERSION to invalidate all cached query responses for a user.
# REQUIRED after deploying any change to grounding / reranking / scoring
# behavior: cached responses store the OLD grounded/evidenceScore verbatim and
# are served before grounding runs (rag-service app/api/query.py).
RAG_CACHE_TTL=3600
INDEX_VERSION=1

# PostgreSQL + pgvector (RAG retrieval/index store). REQUIRED in production.
# Set to your deployed PostgreSQL connection string (NOT localhost).
PG_RAG_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Embedding provider: "local" (sentence-transformers) or "api" (Hugging Face Inference API)
EMBEDDING_PROVIDER=local
# Embedding model name. For local: sentence-transformers model.
# For api: HF model ID (e.g., sentence-transformers/all-MiniLM-L6-v2) - 384 dims.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hugging Face Inference API key (required when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=your_huggingface_api_key
# OpenRouter reranker (used when EMBEDDING_PROVIDER=api). When set, the RAG
# service scores candidates via OpenRouter LLM (stateless, chunks not stored).
# When empty, it falls back to lexical reranking (keyword overlap).
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
